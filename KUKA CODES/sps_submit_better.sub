  ; blocks, and INI must not hang if Ubuntu is not listening yet.
  XD_EKI_ACTIVE = FALSE
  XD_CMD_UPDATING = FALSE
  XD_CMD_SEQ = 0
  XD_GRIPPER_COMMAND = -1
  XD_TRAJ_PTP_VEL_PCT = 0.0
  XD_ENABLE_MOVE = FALSE
  XD_AXIS_MODE = FALSE
  XD_CART_MODE = FALSE
  XD_LAST_MOVE_SEQ = -1
  XD_MOVE_EXECUTED = FALSE
  XD_SEND_COUNTER = 0
  XD_SEND_SEQ = 0
  XD_RX_COUNTER = 0
  XD_OPEN_COUNTER = 0
  FOR xd_tempI = 1 TO 64
    xd_tempMode[xd_tempI] = 0
  ENDFOR
  ; Initialize EKI receive temporary variables
  xd_tempSeq = 0
  xd_tempEnableMove = FALSE
  xd_tempGripper = -1
  xd_tempTrajPtpVelPct = 0.0
  xd_tempBatchSeq = 0
  xd_tempBatchCount = 0
  xd_tempAbortBatch = FALSE
  xd_tempBatchVelPct = 0.0
  xd_batchRead = 0
  xd_batchI = 0
  xd_batchBuff = 0
  xd_batchLeft = 0
  ; Batch diagnostic register: cleared once at boot so a value left
  ; over from a previous run can never be mistaken for this one.
  ; Only a packet with BatchCount > 0 ever writes it again, so a
  ; failed batch stays readable instead of being overwritten by the
  ; next ordinary heartbeat packet.
  XD_SPS_RUNNING_ID = 0
  ; ---- EKI destinations MUST be initialized before the first Get ----
  ; KST Ethernet KRL 3.0, 6.2.5 "Reading out data", p. 39: "In order to
  ; read out data, the corresponding KRL variables have to be initialized,
  ; e.g. by the assignment of values."  Every KUKA example program does it
  ; (XmlTransmit.src, XmlCallback.src, BinaryFixed.src), and xd_tempMode[]
  ; twelve lines above already did.  The six batch staging arrays were the
  ; ONLY EKI destinations in this project that did not - they went into
  ; EKI_GetReal declared but never initialized.
  ; XD_BATCH_A* is seeded here for the same reason on the other side:
  ; config_submit_better.dat declares those six arrays with no initializer,
  ; so without this XmlDualMove_better.src could read a declared-but-not-
  ; initialized element out of $CONFIG.DAT.
  ; 20 is the declared dimension of all twelve arrays (= XD_BATCH_MAX).
  FOR xd_batchI = 1 TO 20
    xd_tempBatchA1[xd_batchI] = 0.0
    xd_tempBatchA2[xd_batchI] = 0.0
    xd_tempBatchA3[xd_batchI] = 0.0
    xd_tempBatchA4[xd_batchI] = 0.0
    xd_tempBatchA5[xd_batchI] = 0.0
    xd_tempBatchA6[xd_batchI] = 0.0
    XD_BATCH_A1[xd_batchI] = 0.0
    XD_BATCH_A2[xd_batchI] = 0.0
    XD_BATCH_A3[xd_batchI] = 0.0
    XD_BATCH_A4[xd_batchI] = 0.0
    XD_BATCH_A5[xd_batchI] = 0.0
    XD_BATCH_A6[xd_batchI] = 0.0
  ENDFOR
  xd_batchI = 0
  XD_BATCH_SEQ = 0
  XD_BATCH_COUNT = 0
  XD_BATCH_CONSUMED_COUNT = 0
  XD_BATCH_ACTIVE = FALSE
  XD_ABORT_BATCH = FALSE
  XD_BATCH_PTP_VEL_PCT = 0.0

