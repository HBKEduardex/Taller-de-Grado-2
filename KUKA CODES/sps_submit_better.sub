  DECL INT xd_tempSeq
  DECL BOOL xd_tempEnableMove
  DECL CHAR xd_tempMode[64]
  DECL INT xd_tempGripper
  DECL REAL xd_tempTrajPtpVelPct

  ; ---- BATCH MODE (XmlDualMove_better) ----
  ; Locals only.  Nothing above was renamed, retyped or removed.
  DECL INT xd_tempBatchSeq
  DECL INT xd_tempBatchCount
  DECL BOOL xd_tempAbortBatch
  DECL REAL xd_tempBatchVelPct
  DECL BOOL xd_batchPresent
  DECL INT xd_batchRead
  DECL INT xd_batchI
  ; Entries the Command/Pt/@A1 memory held BEFORE the point loops ran, and
  ; the total still left in the six memories AFTER them.  Both are pure
  ; diagnostics: EKI_CheckBuffer does not change the memory (KST Ethernet
  ; KRL 3.0, 10.4.6, p. 111).
  DECL INT xd_batchBuff
  DECL INT xd_batchLeft
  ; Staging arrays filled one element at a time with EKI_GetReal.
  ; See the batch read block for why the array call is not used.
  DECL REAL xd_tempBatchA1[20]
  DECL REAL xd_tempBatchA2[20]
  DECL REAL xd_tempBatchA3[20]
  DECL REAL xd_tempBatchA4[20]
  DECL REAL xd_tempBatchA5[20]
  DECL REAL xd_tempBatchA6[20]
