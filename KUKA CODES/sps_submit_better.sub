    ;FOLD USER PLC
    ;Make your modifications here

    ; ==========================================================
    ; XmlDualMove - the Submit interpreter OWNS the EKI channel
    ; ==========================================================
    ; EKI_Init / EKI_Open / EKI_Close and every Get/Set live here.  The
    ; robot interpreter never touches EKI, so telemetry keeps flowing
    ; whichever program is selected: DEMO26, XmlDualMove, or none at all.
    ;
    ; The receive buffer is drained on EVERY cycle.  Nothing gates it on the
    ; robot interpreter any more - that gate is what let the EKI memory fill
    ; up and raise EKI01280, because EthernetKRL closes the connection when
    ; a memory reaches its element limit instead of dropping old entries.
    ;
    ; A valid packet is published into the XD_ mailbox, newest wins.  There
    ; is no queue in KRL: if Seq 100, 101 and 102 arrive back to back, all
    ; three are consumed and the mailbox simply ends up holding 102.
    ;
    ; THE SPS NEVER EXECUTES MOTION AND NEVER DRIVES THE GRIPPER.

    ; ---------- 1. Connection management ----------
    ; Ubuntu is the TCP server, so the KUKA is the client and EKI_Open()
    ; blocks until the link is up or <TIMEOUT Connect> (500 ms) expires.
    ; Retries are paced so a missing server cannot stall the PLC.
    IF XD_EKI_ACTIVE == FALSE THEN
      XD_OPEN_COUNTER = XD_OPEN_COUNTER + 1
      IF XD_OPEN_COUNTER >= XD_OPEN_RETRY_CYCLES THEN
        XD_OPEN_COUNTER = 0
        XD_RET = EKI_Init("XmlDualMove_better")
        IF XD_RET.Msg_No == 0 THEN
          XD_RET = EKI_Open("XmlDualMove_better")
          IF (XD_RET.Msg_No == 0) AND (XD_RET.Connected == TRUE) THEN
            ; Fresh channel means a fresh mailbox.  Seq 0 is the "no command
            ; yet" sentinel; the robot interpreter ignores anything <= 0.
            XD_CMD_UPDATING = FALSE
            XD_CMD_SEQ = 0
            XD_GRIPPER_COMMAND = -1
            XD_TRAJ_PTP_VEL_PCT = 0.0
            XD_ENABLE_MOVE = FALSE
            XD_RX_COUNTER = 0
            XD_SEND_COUNTER = 0
            XD_EKI_ACTIVE = TRUE
          ELSE
            XD_RET = EKI_Clear("XmlDualMove_better")
          ENDIF
        ENDIF
      ENDIF
    ENDIF

    ; ---------- 2. Receive and transmit ----------
    IF XD_EKI_ACTIVE == TRUE THEN
      xd_channelOK = TRUE
      xd_packetOK = FALSE

      ; ---- RX: always drain, one complete packet per cycle ----
      ; One packet per cycle is ~6 packets/s of drain capacity against a
      ; bridge that sends at ~2 Hz, so the buffer cannot build up.  Draining
      ; more per cycle would only make the SPS cycle time spikier.
      XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Seq")
      IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
        xd_channelOK = FALSE
      ELSE
        IF XD_RET.Buff > 0 THEN
          xd_packetOK = TRUE
          xd_packetCounter = -1

        XD_RET = EKI_GetInt("XmlDualMove_better", "Command/Seq", xd_tempSeq)
        IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
          xd_channelOK = FALSE
          xd_packetOK = FALSE
        ELSE
          IF XD_RET.Read <> 1 THEN
            xd_packetOK = FALSE
          ELSE
            xd_packetCounter = XD_RET.Counter
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetString("XmlDualMove_better", "Command/Mode", xd_tempMode[])
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetBool("XmlDualMove_better", "Command/EnableMove", xd_tempEnableMove)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A1", xd_tempA1)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A2", xd_tempA2)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A3", xd_tempA3)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A4", xd_tempA4)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A5", xd_tempA5)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/AxisTarget/@A6", xd_tempA6)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@X", xd_tempX)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@Y", xd_tempY)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@Z", xd_tempZ)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@A", xd_tempA)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@B", xd_tempB)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/CartesianTarget/@C", xd_tempC)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetInt("XmlDualMove_better", "Command/GripperCommand", xd_tempGripper)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/TrajectoryPtpVelocityPct", xd_tempTrajPtpVelPct)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF

        ; ================= BATCH MODE: scalars =================
        ; BatchCount > 0 is the ONLY discriminator of a batch packet.
        ; Command/Mode stays "AxisTarget": mode detection below keys on the
        ; FIRST CHARACTER of that string, so a value like "AxisTargetBatch"
        ; would be indistinguishable from "AxisTarget" and would make the
        ; baseline program treat a batch as a single point.

        ; ---- Are the batch memories present in THIS packet? ----
        ; A plain command carries no Batch* tags at all: the baseline
        ; bridge never emits them.  Reading an empty EKI memory raises
        ; EKI00015 and the fail-safe closes the channel, so all four
        ; reads below are gated on CheckBuffer first.  The defaults mean
        ; "no batch": the publish block skips its whole batch section and
        ; XD_BATCH_* is left untouched.
        xd_tempBatchSeq = 0
        xd_tempBatchCount = 0
        xd_tempAbortBatch = FALSE
        xd_tempBatchVelPct = 0.0
        xd_batchPresent = FALSE
        IF xd_channelOK AND xd_packetOK THEN
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/BatchCount")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchPresent = (XD_RET.Buff > 0)
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK AND xd_batchPresent THEN
          XD_RET = EKI_GetInt("XmlDualMove_better", "Command/BatchSeq", xd_tempBatchSeq)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK AND xd_batchPresent THEN
          XD_RET = EKI_GetInt("XmlDualMove_better", "Command/BatchCount", xd_tempBatchCount)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK AND xd_batchPresent THEN
          XD_RET = EKI_GetBool("XmlDualMove_better", "Command/AbortBatch", xd_tempAbortBatch)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF
        IF xd_channelOK AND xd_packetOK AND xd_batchPresent THEN
          XD_RET = EKI_GetReal("XmlDualMove_better", "Command/BatchPtpVelocityPct", xd_tempBatchVelPct)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
              xd_packetOK = FALSE
            ENDIF
          ENDIF
        ENDIF

        ; ---- The count must fit the arrays BEFORE it is used as a bound ----
        ; xd_tempBatchCount arrives from the wire.  It is used two lines
        ; below as the upper bound of six FOR loops that index arrays
        ; dimensioned [20], and the only <= XD_BATCH_MAX test used to sit
        ; far downstream in the publish block - after the indexing had
        ; already happened.  A count above 20 therefore wrote past the end
        ; of the six staging arrays.  A count that does not fit makes the
        ; packet inconsistent; the resync block below then clears every
        ; memory, so nothing half-read can reach the mailbox.
        IF xd_channelOK AND xd_packetOK AND xd_batchPresent THEN
          IF (xd_tempBatchCount < 0) OR (xd_tempBatchCount > XD_BATCH_MAX) THEN
            xd_packetOK = FALSE
            ; 2 99 00 00 = "BatchCount off the wire did not fit XD_BATCH_MAX".
            ; Written BEFORE the count is zeroed, or the case would be
            ; indistinguishable from "no batch in this packet".
            XD_SPS_RUNNING_ID = 2990000
            xd_tempBatchCount = 0
          ENDIF
        ENDIF

        ; ================= BATCH MODE: the points =================
        ; Read ONE element at a time with EKI_GetReal.  EKI_GetReal is the
        ; proven call here: the baseline SPS issues 14 of them per cycle.
        ; Each call pops the next entry of the FIFO memory, so a loop of
        ; BatchCount reads drains exactly the points of THIS packet.
        ;
        ; CAVEAT, and it is the open question of this design: one <Command>
        ; carries the SAME element name <Pt/> BatchCount times, and KST
        ; Ethernet KRL 3.0 never documents a repeated element.  Its data
        ; model is one entry per element per DATA RECORD (6.2.7 p. 41:
        ; "Counter - time stamp for received data PACKETS"; 6.2.10 p. 44:
        ; "data from various data PACKETS are present in one memory layer").
        ; No KUKA example config repeats an element.  xd_batchBuff below
        ; measures what the controller actually does with it: send a batch
        ; of N and read XD_SPS_RUNNING_ID on the smartPad.  If the buff
        ; digits come back 1 while the count digits say N, repetitions
        ; collapse and the encoding has to become one named element per
        ; point.  If they come back N, repetitions stack and this is fine.
        ;
        ; Counter is deliberately NOT checked on these reads: it identifies
        ; the data PACKET, and all N repetitions share the packet of
        ; Command/Seq, so the per-element rule used above does not apply.
        ; Read <> 1 is checked on every single one of them instead.
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          xd_batchBuff = 0
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A1")
          IF (XD_RET.Msg_No == 0) AND (XD_RET.Connected == TRUE) THEN
            xd_batchBuff = XD_RET.Buff
          ENDIF
          IF xd_batchBuff > 99 THEN
            xd_batchBuff = 99
          ENDIF
          ; Diagnostic register, decimal S-BB-CC-FF:
          ;   S  3 = about to read the points
          ;      4 = all points read and the six memories came out empty
          ;      5 = batch published into XD_BATCH_*
          ;      8 = a point read failed or the memories did not match
          ;   BB entries Command/Pt/@A1 held before reading
          ;   CC BatchCount decoded from the packet
          ;   FF reserved, always 00
          XD_SPS_RUNNING_ID = 3000000 + (xd_batchBuff * 10000) + (xd_tempBatchCount * 100)
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A1", xd_tempBatchA1[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A2", xd_tempBatchA2[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A3", xd_tempBatchA3[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A4", xd_tempBatchA4[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A5", xd_tempBatchA5[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          FOR xd_batchI = 1 TO xd_tempBatchCount
            IF xd_channelOK AND xd_packetOK THEN
              XD_RET = EKI_GetReal("XmlDualMove_better", "Command/Pt/@A6", xd_tempBatchA6[xd_batchI])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF XD_RET.Read <> 1 THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF
          ENDFOR
        ENDIF

        ; ---- The six axis memories must come out EXACTLY drained ----
        ; Six independent memories are filled from the same <Pt/> rows, so
        ; "A1 got 20 and A2 got 19" is a real failure mode and it has to be
        ; caught HERE, before anything reaches XD_BATCH_*: a batch short on
        ; one axis would move the robot through a point nobody sent.
        ; Read <> 1 above already proves each of the 6*BatchCount reads
        ; returned one value; this proves nothing was LEFT OVER, which is
        ; the other half of the same guarantee.
        ; EKI_CheckBuffer does not change the memory (KST Ethernet KRL 3.0,
        ; 10.4.6, p. 111), so this has no side effects.
        IF xd_channelOK AND xd_packetOK AND (xd_tempBatchCount > 0) THEN
          xd_batchLeft = 0
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A1")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A2")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A3")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A4")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A5")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Pt/@A6")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
            xd_packetOK = FALSE
          ELSE
            xd_batchLeft = xd_batchLeft + XD_RET.Buff
          ENDIF
          IF xd_batchLeft <> 0 THEN
            xd_packetOK = FALSE
          ENDIF
        ENDIF

        ; ---- Diagnostic register: how far the batch read got ----
        IF (xd_tempBatchCount > 0) AND xd_channelOK AND xd_packetOK THEN
          XD_SPS_RUNNING_ID = 4000000 + (xd_batchBuff * 10000) + (xd_tempBatchCount * 100)
        ENDIF
        IF (xd_tempBatchCount > 0) AND (xd_packetOK == FALSE) THEN
          XD_SPS_RUNNING_ID = 8000000 + (xd_batchBuff * 10000) + (xd_tempBatchCount * 100)
        ENDIF

        ; ---- Publish the mailbox ----
        IF xd_channelOK AND xd_packetOK THEN
          XD_CMD_UPDATING = TRUE
          XD_TARGET_A1 = xd_tempA1
          XD_TARGET_A2 = xd_tempA2
          XD_TARGET_A3 = xd_tempA3
          XD_TARGET_A4 = xd_tempA4
          XD_TARGET_A5 = xd_tempA5
          XD_TARGET_A6 = xd_tempA6
          XD_TARGET_X = xd_tempX
          XD_TARGET_Y = xd_tempY
          XD_TARGET_Z = xd_tempZ
          XD_TARGET_A = xd_tempA
          XD_TARGET_B = xd_tempB
          XD_TARGET_C = xd_tempC
          XD_ENABLE_MOVE = xd_tempEnableMove
          XD_AXIS_MODE = (xd_tempMode[1] == "A") OR (xd_tempMode[1] == "a")
          XD_CART_MODE = (xd_tempMode[1] == "C") OR (xd_tempMode[1] == "c")
          ; Gripper: accept only -1, 0 or 1.  Anything else means "do nothing".
          IF (xd_tempGripper == 0) OR (xd_tempGripper == 1) THEN
            XD_GRIPPER_COMMAND = xd_tempGripper
          ELSE
            XD_GRIPPER_COMMAND = -1
          ENDIF
          ; 0.0 preserves manual/legacy commands. Invalid explicit values use
          ; -1.0 so the robot interpreter blocks motion instead of guessing.
          IF xd_tempTrajPtpVelPct == 0.0 THEN
            XD_TRAJ_PTP_VEL_PCT = 0.0
          ELSE
            IF (xd_tempTrajPtpVelPct > 0.0) AND (xd_tempTrajPtpVelPct <= 100.0) THEN
              XD_TRAJ_PTP_VEL_PCT = xd_tempTrajPtpVelPct
            ELSE
              XD_TRAJ_PTP_VEL_PCT = -1.0
            ENDIF
          ENDIF
          ; ---- BATCH MODE: publish before XD_CMD_SEQ ----
          ; XD_ABORT_BATCH is latched, never cleared here: only the robot
          ; interpreter clears it, when it actually stops the batch.  A
          ; later packet that does not carry the abort must not undo it.
          IF xd_tempAbortBatch THEN
            XD_ABORT_BATCH = TRUE
          ENDIF
          ; A batch is accepted only when the count is sane and the array
          ; read matched it.  Anything else leaves XD_BATCH_COUNT untouched
          ; and the robot interpreter simply does not start a new batch.
          IF (xd_tempBatchCount > 0) AND (xd_tempBatchCount <= XD_BATCH_MAX) THEN
            FOR xd_batchI = 1 TO xd_tempBatchCount
              XD_BATCH_A1[xd_batchI] = xd_tempBatchA1[xd_batchI]
              XD_BATCH_A2[xd_batchI] = xd_tempBatchA2[xd_batchI]
              XD_BATCH_A3[xd_batchI] = xd_tempBatchA3[xd_batchI]
              XD_BATCH_A4[xd_batchI] = xd_tempBatchA4[xd_batchI]
              XD_BATCH_A5[xd_batchI] = xd_tempBatchA5[xd_batchI]
              XD_BATCH_A6[xd_batchI] = xd_tempBatchA6[xd_batchI]
            ENDFOR
            ; Same validation rule as XD_TRAJ_PTP_VEL_PCT.
            IF xd_tempBatchVelPct == 0.0 THEN
              XD_BATCH_PTP_VEL_PCT = 0.0
            ELSE
              IF (xd_tempBatchVelPct > 0.0) AND (xd_tempBatchVelPct <= 100.0) THEN
                XD_BATCH_PTP_VEL_PCT = xd_tempBatchVelPct
              ELSE
                XD_BATCH_PTP_VEL_PCT = -1.0
              ENDIF
            ENDIF
            XD_BATCH_COUNT = xd_tempBatchCount
            ; Written LAST of the batch block: batch-complete marker,
            ; exactly like XD_CMD_SEQ is for a single point.
            XD_BATCH_SEQ = xd_tempBatchSeq
            XD_SPS_RUNNING_ID = 5000000 + (xd_batchBuff * 10000) + (xd_tempBatchCount * 100)
          ENDIF
          ; Published LAST: XD_CMD_SEQ is the packet-complete marker the robot
          ; interpreter watches.
          XD_CMD_SEQ = xd_tempSeq
          XD_CMD_UPDATING = FALSE
          ; Explicit RX acknowledgement for the Ubuntu bridge.
          XD_RX_COUNTER = XD_RX_COUNTER + 1
        ENDIF

        ; ---- Inconsistent packet: resync every memory ----
        IF xd_channelOK AND (xd_packetOK == FALSE) THEN
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Seq")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Mode")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/EnableMove")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A1")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A2")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A3")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A4")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A5")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AxisTarget/@A6")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@X")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@Y")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@Z")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@A")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@B")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/CartesianTarget/@C")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/GripperCommand")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/TrajectoryPtpVelocityPct")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/BatchSeq")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/BatchCount")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/AbortBatch")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/BatchPtpVelocityPct")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A1")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A2")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A3")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A4")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A5")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_channelOK THEN
          XD_RET = EKI_ClearBuffer("XmlDualMove_better", "Command/Pt/@A6")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        ENDIF
        ENDIF
      ENDIF

      ; ---- An RX fault must not silence telemetry ----
      ; A read error is a PACKET problem, not a LINK problem: a malformed
      ; value, an empty memory or a torn packet says nothing about the
      ; socket.  Killing TX for the rest of the cycle would also drop
      ; Robot/BatchSeq, which is exactly what ROS uses to detect that this
      ; controller supports batch at all.
      ; The link is only really down when EthernetKRL says so, so ask it:
      ; EKI_CheckBuffer moves no data and still reports .Connected.
      IF xd_channelOK == FALSE THEN
        XD_RET = EKI_CheckBuffer("XmlDualMove_better", "Command/Seq")
        IF XD_RET.Connected == TRUE THEN
          xd_channelOK = TRUE
        ENDIF
      ENDIF

      ; ---- TX: telemetry ----
      IF xd_channelOK THEN
        XD_SEND_COUNTER = XD_SEND_COUNTER + 1
        IF XD_SEND_COUNTER >= XD_SEND_DIVISOR THEN
          XD_SEND_COUNTER = 0

          ; ---- Protected acquisition of the Cartesian position ----
          ; $POS_ACT is not stored, it is derived from $AXIS_ACT through
          ; $TOOL and $BASE.  When a KRL program is deselected those frames
          ; can be left undefined and then READING $POS_ACT is itself the
          ; runtime error - that is the instant SmartHMI shows XYZABC blank.
          ; Checking XD_RET afterwards cannot help: the error is raised while
          ; the argument is being evaluated, so EKI_SetReal is never entered
          ; and never returns a status.  Without ON_ERROR_PROCEED the Submit
          ; interpreter stops right there.
          ;
          ; ON_ERROR_PROCEED suppresses the error of the SINGLE statement
          ; that follows it and skips that statement.  It must sit directly
          ; in front of a plain assignment - it has no effect on IF, FOR,
          ; WHILE, LOOP, REPEAT, SWITCH or GOTO.  $ERR is per interpreter,
          ; so this is the Submit's own error slot, not the robot's.
          ;
          ; One struct copy yields all six components from the SAME instant.
          xd_cartValid = TRUE
          ON_ERROR_PROCEED
          xd_posSnapshot = $POS_ACT
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF

          ; The six components come out of the local snapshot, never out of
          ; $POS_ACT again.  A struct copy can carry uninitialised members
          ; through without failing, so each extraction is guarded too; past
          ; this point the EKI block only ever sees plain initialised REALs.
          ON_ERROR_PROCEED
          xd_posX = xd_posSnapshot.X
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF
          ON_ERROR_PROCEED
          xd_posY = xd_posSnapshot.Y
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF
          ON_ERROR_PROCEED
          xd_posZ = xd_posSnapshot.Z
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF
          ON_ERROR_PROCEED
          xd_posA = xd_posSnapshot.A
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF
          ON_ERROR_PROCEED
          xd_posB = xd_posSnapshot.B
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF
          ON_ERROR_PROCEED
          xd_posC = xd_posSnapshot.C
          IF $ERR.NUMBER <> 0 THEN
            ERR_CLEAR($ERR)
            xd_cartValid = FALSE
          ENDIF

          ; An unusable Cartesian position is NOT an EthernetKRL fault, so
          ; xd_channelOK, XD_EKI_ACTIVE, RX and the mailbox are left alone.
          ; The round is simply consumed and produces no Robot frame, which
          ; is why Robot/Seq must not advance either.
          IF xd_cartValid THEN
          XD_SEND_SEQ = XD_SEND_SEQ + 1
          xd_sendOK = TRUE
          xd_sentMoveSeq = XD_LAST_MOVE_SEQ
          xd_sendMoveExecuted = XD_MOVE_EXECUTED

        IF xd_sendOK THEN
          XD_RET = EKI_SetInt("XmlDualMove_better", "Robot/Seq", XD_SEND_SEQ)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          IF XD_CART_MODE THEN
            XD_RET = EKI_SetString("XmlDualMove_better", "Robot/Mode", "CartesianTarget")
          ELSE
            XD_RET = EKI_SetString("XmlDualMove_better", "Robot/Mode", "AxisTarget")
          ENDIF
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A1", $AXIS_ACT.A1)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A2", $AXIS_ACT.A2)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A3", $AXIS_ACT.A3)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A4", $AXIS_ACT.A4)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A5", $AXIS_ACT.A5)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/AxisActual/@A6", $AXIS_ACT.A6)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@X", xd_posX)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@Y", xd_posY)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@Z", xd_posZ)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@A", xd_posA)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@B", xd_posB)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetReal("XmlDualMove_better", "Robot/Data/PositionActual/@C", xd_posC)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetInt("XmlDualMove_better", "Robot/Status", 1)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetBool("XmlDualMove_better", "Robot/MoveReady", XD_MOVE_READY)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetBool("XmlDualMove_better", "Robot/LimitsOK", XD_LIMITS_OK)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetBool("XmlDualMove_better", "Robot/DeltaOK", XD_DELTA_OK)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetBool("XmlDualMove_better", "Robot/MoveExecuted", xd_sendMoveExecuted)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetInt("XmlDualMove_better", "Robot/RxCounter", XD_RX_COUNTER)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        ; ---- BATCH MODE telemetry ----
        ; Rides the SAME periodic block that already carries Robot/RxCounter.
        ; No new channel, no new connection, no new port.
        IF xd_sendOK THEN
          XD_RET = EKI_SetInt("XmlDualMove_better", "Robot/BatchSeq", XD_BATCH_SEQ)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetInt("XmlDualMove_better", "Robot/BatchConsumed", XD_BATCH_CONSUMED_COUNT)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_SetBool("XmlDualMove_better", "Robot/BatchActive", XD_BATCH_ACTIVE)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF
        IF xd_sendOK THEN
          XD_RET = EKI_Send("XmlDualMove_better", "Robot")
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF
        ENDIF

        ; Report MoveExecuted once for the captured move sequence.
        IF xd_sendOK AND xd_sendMoveExecuted THEN
          IF XD_LAST_MOVE_SEQ == xd_sentMoveSeq THEN
            XD_MOVE_EXECUTED = FALSE
          ENDIF
        ENDIF
          ENDIF
        ENDIF
      ENDIF

      ; ---- Fail safe: drop the channel and let section 1 reopen it ----
      IF xd_channelOK == FALSE THEN
        XD_EKI_ACTIVE = FALSE
        XD_ENABLE_MOVE = FALSE
        XD_MOVE_READY = FALSE
        XD_CMD_UPDATING = FALSE
        XD_GRIPPER_COMMAND = -1
        ; Batch state dies with the channel: a half-delivered batch must
        ; never survive a reconnect and start moving on its own.
        XD_BATCH_SEQ = 0
        XD_BATCH_COUNT = 0
        XD_BATCH_CONSUMED_COUNT = 0
        XD_BATCH_ACTIVE = FALSE
        XD_ABORT_BATCH = FALSE
        XD_BATCH_PTP_VEL_PCT = 0.0
        XD_OPEN_COUNTER = 0
        XD_RET = EKI_Close("XmlDualMove_better")
        XD_RET = EKI_Clear("XmlDualMove_better")
      ENDIF
    ENDIF

    ;ENDFOLD (USER PLC)
  ENDLOOP
  ;FOLD ;%{H}
  ;FOLD
END
  ;ENDFOLD


DEF  RESET_OUT ( )
  INT N
  MsgLoop(" ")
  IF REFLECT_PROG_NR == 1 THEN
    FOR N = 0 TO PGNO_LENGTH - 1
      $OUT[PGNO_FBIT_REFL + N] = FALSE
    ENDFOR
  ENDIF
  IF (PGNO_REQ>0) THEN
    $OUT[PGNO_REQ]=FALSE
  ELSE
    IF (PGNO_REQ<0) THEN
      $OUT[-PGNO_REQ]=TRUE
    ENDIF
  ENDIF
END

DEF RESET_LINESEL()
  $LINE_SEL_OK=FALSE
END
