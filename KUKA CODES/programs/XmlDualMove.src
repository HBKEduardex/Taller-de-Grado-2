&ACCESS RV
&REL 1
&PARAM DISKPATH = KRC:\R1\Program
&PARAM SensorITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF XmlDualMove( )

; ============================================================================
; XmlDualMove - robot-interpreter side of the ROS2 link
; ============================================================================
; THIS PROGRAM CONTAINS NO EthernetKRL CALLS.
;
; SPS.SUB owns the EKI channel: it opens it, drains the receive buffer on
; every cycle and publishes the last valid command into the XD_ mailbox in
; $CONFIG.DAT.  This program only reads that mailbox.  Consequences:
;
;   * Telemetry no longer depends on this program running.  DEMO26 or any
;     other KRL program can be selected and Ubuntu keeps receiving data.
;   * The receive buffer is never blocked by the robot interpreter, which is
;     what used to fill the EKI memory and raise EKI01280.
;   * The manual warns against reading one channel from both interpreters
;     (EKI_Get empties the memory), so all reading stays in the SPS.
;
; SAFETY MODEL
;   * On start-up the current mailbox Seq is taken as a BASELINE and is never
;     executed.  A command that arrived while DEMO26 was running can never
;     move the robot just because this program was selected afterwards.
;   * A Seq is marked handled BEFORE acting on it, so a given Seq can move
;     the robot or drive the gripper at most once.  The Ubuntu heartbeat
;     deliberately repeats the same Seq and is therefore inert.
;   * Gripper and motion are independent: EnableMove=FALSE with
;     GripperCommand 0 or 1 performs a gripper-only action.
;
; ORDER OF EXECUTION for a new Seq:  validate -> gripper -> motion.
; ============================================================================

;FOLD Declaration
  INT i
  INT cmdSeq
  INT cmdSeqCheck
  INT handledSeq
  INT gripperCmd

  DECL AXIS axisTarget
  DECL E6POS cartesianTarget

  BOOL snapshotOK
  BOOL isAxisMode
  BOOL isCartesianMode

  BOOL enableMove
  BOOL limitsOK
  BOOL readyToMove
  BOOL moveExecuted
  BOOL deltaOK
  BOOL velocityOK
  BOOL hasTrajectoryVelocity

  REAL targetA1
  REAL targetA2
  REAL targetA3
  REAL targetA4
  REAL targetA5
  REAL targetA6

  REAL targetX
  REAL targetY
  REAL targetZ
  REAL targetA
  REAL targetB
  REAL targetC
  REAL ptpVelocityPct

  REAL errorA1
  REAL errorA2
  REAL errorA3
  REAL errorA4
  REAL errorA5
  REAL errorA6

  REAL errorX
  REAL errorY
  REAL errorZ
  REAL errorA
  REAL errorB
  REAL errorC

  REAL MAX_DELTA_JOINT
  REAL MAX_DELTA_POS
  REAL MAX_DELTA_ORI
;ENDFOLD (Declaration)

;FOLD INI
  ;FOLD BASISTECH INI
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)

  ;FOLD USER INI
    ;Reads targets from the XD_ mailbox published by SPS.SUB.
    ;Supports BOTH Axis (A1-A6) and Cartesian (X,Y,Z,A,B,C) modes.
    ;Movement must be enabled by the responsible operator via the bridge.
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD Initialize data
  cmdSeq = 0
  cmdSeqCheck = 0
  gripperCmd = -1

  snapshotOK = FALSE
  enableMove = FALSE
  limitsOK = FALSE
  readyToMove = FALSE
  moveExecuted = FALSE
  deltaOK = FALSE
  velocityOK = FALSE
  hasTrajectoryVelocity = FALSE
  isAxisMode = FALSE
  isCartesianMode = FALSE

  targetA1 = $AXIS_ACT.A1
  targetA2 = $AXIS_ACT.A2
  targetA3 = $AXIS_ACT.A3
  targetA4 = $AXIS_ACT.A4
  targetA5 = $AXIS_ACT.A5
  targetA6 = $AXIS_ACT.A6

  targetX = $POS_ACT.X
  targetY = $POS_ACT.Y
  targetZ = $POS_ACT.Z
  targetA = $POS_ACT.A
  targetB = $POS_ACT.B
  targetC = $POS_ACT.C
  ptpVelocityPct = 0.0

  errorA1 = 0.0
  errorA2 = 0.0
  errorA3 = 0.0
  errorA4 = 0.0
  errorA5 = 0.0
  errorA6 = 0.0

  errorX = 0.0
  errorY = 0.0
  errorZ = 0.0
  errorA = 0.0
  errorB = 0.0
  errorC = 0.0

  MAX_DELTA_JOINT = 10.0
  MAX_DELTA_POS = 100.0  ; 100 mm jump max in X, Y, Z
  MAX_DELTA_ORI = 20.0   ; 20 degrees jump max in A, B, C

  axisTarget = $AXIS_ACT
  cartesianTarget = $POS_ACT

  ; ---- BASELINE ----
  ; Whatever is sitting in the mailbox right now belongs to the past: it may
  ; have arrived while DEMO26 was running, or be the last command of an
  ; earlier ROS2 session.  Treating it as already handled is what stops this
  ; program from moving the moment it is selected.
  handledSeq = XD_CMD_SEQ

  XD_MOVE_READY = FALSE
  XD_LIMITS_OK = FALSE
  XD_DELTA_OK = FALSE
;ENDFOLD (Initialize data)

;FOLD Configure motion parameters
  $BWDSTART = FALSE

  ; Default TOOL and BASE (modify if your setup requires specific ones)
  $TOOL = $NULLFRAME
  $BASE = $NULLFRAME
;ENDFOLD (Configure motion parameters)

;FOLD Move command loop
LOOP

  ;FOLD Snapshot the mailbox
    ; Seqlock read: XD_CMD_SEQ is written LAST by the SPS, so reading it
    ; before and after the payload detects a publish that landed mid-copy.
    ; A torn snapshot is simply discarded and retried next cycle.
    snapshotOK = FALSE

    IF XD_CMD_UPDATING == FALSE THEN
      cmdSeqCheck = XD_CMD_SEQ

      targetA1 = XD_TARGET_A1
      targetA2 = XD_TARGET_A2
      targetA3 = XD_TARGET_A3
      targetA4 = XD_TARGET_A4
      targetA5 = XD_TARGET_A5
      targetA6 = XD_TARGET_A6

      targetX = XD_TARGET_X
      targetY = XD_TARGET_Y
      targetZ = XD_TARGET_Z
      targetA = XD_TARGET_A
      targetB = XD_TARGET_B
      targetC = XD_TARGET_C

      enableMove = XD_ENABLE_MOVE
      gripperCmd = XD_GRIPPER_COMMAND
      ptpVelocityPct = XD_TRAJ_PTP_VEL_PCT
      isAxisMode = XD_AXIS_MODE
      isCartesianMode = XD_CART_MODE

      IF (XD_CMD_UPDATING == FALSE) AND (XD_CMD_SEQ == cmdSeqCheck) THEN
        cmdSeq = cmdSeqCheck
        snapshotOK = TRUE
      ENDIF
    ENDIF
  ;ENDFOLD (Snapshot the mailbox)

  ;FOLD Follow a mailbox reset
    ; XD_CMD_SEQ == 0 is the sentinel the SPS writes when it (re)opens the
    ; channel: the mailbox holds no command at all.  There is nothing from
    ; the past to protect against, so the handled marker follows it down.
    ; Without this, a fresh ROS2 session that restarts its counter at 1 could
    ; have its very first command silently ignored.
    IF snapshotOK == TRUE THEN
      IF cmdSeq == 0 THEN
        handledSeq = 0
      ENDIF
    ENDIF
  ;ENDFOLD (Follow a mailbox reset)

  ;FOLD Calculate error target - actual
    IF isAxisMode THEN
      errorA1 = targetA1 - $AXIS_ACT.A1
      errorA2 = targetA2 - $AXIS_ACT.A2
      errorA3 = targetA3 - $AXIS_ACT.A3
      errorA4 = targetA4 - $AXIS_ACT.A4
      errorA5 = targetA5 - $AXIS_ACT.A5
      errorA6 = targetA6 - $AXIS_ACT.A6
    ENDIF

    IF isCartesianMode THEN
      errorX = targetX - $POS_ACT.X
      errorY = targetY - $POS_ACT.Y
      errorZ = targetZ - $POS_ACT.Z
      errorA = targetA - $POS_ACT.A
      errorB = targetB - $POS_ACT.B
      errorC = targetC - $POS_ACT.C
    ENDIF
  ;ENDFOLD (Calculate error target - actual)

  ;FOLD Validate limits
    limitsOK = TRUE

    IF isAxisMode THEN
      IF targetA1 < -160.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA1 > 160.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA2 < -180.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA2 > 35.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA3 < -110.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA3 > 146.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA4 < -175.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA4 > 175.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA5 < -110.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA5 > 110.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA6 < -340.0 THEN
        limitsOK = FALSE
      ENDIF
      IF targetA6 > 340.0 THEN
        limitsOK = FALSE
      ENDIF
    ENDIF

    ; Note: Cartesian limits are harder to define safely without a known workspace.
    ; Native KUKA reachability will prevent unsafe poses, but you can add boundary boxes here if needed.
  ;ENDFOLD (Validate limits)

  XD_LIMITS_OK = limitsOK

  ;FOLD Validate delta (max jump per command)
    deltaOK = TRUE

    IF isAxisMode THEN
      IF (errorA1 > MAX_DELTA_JOINT) OR (errorA1 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA2 > MAX_DELTA_JOINT) OR (errorA2 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA3 > MAX_DELTA_JOINT) OR (errorA3 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA4 > MAX_DELTA_JOINT) OR (errorA4 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA5 > MAX_DELTA_JOINT) OR (errorA5 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA6 > MAX_DELTA_JOINT) OR (errorA6 < -MAX_DELTA_JOINT) THEN
        deltaOK = FALSE
      ENDIF
    ENDIF

    IF isCartesianMode THEN
      IF (errorX > MAX_DELTA_POS) OR (errorX < -MAX_DELTA_POS) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorY > MAX_DELTA_POS) OR (errorY < -MAX_DELTA_POS) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorZ > MAX_DELTA_POS) OR (errorZ < -MAX_DELTA_POS) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorA > MAX_DELTA_ORI) OR (errorA < -MAX_DELTA_ORI) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorB > MAX_DELTA_ORI) OR (errorB < -MAX_DELTA_ORI) THEN
        deltaOK = FALSE
      ENDIF
      IF (errorC > MAX_DELTA_ORI) OR (errorC < -MAX_DELTA_ORI) THEN
        deltaOK = FALSE
      ENDIF
    ENDIF
  ;ENDFOLD (Validate delta)

  XD_DELTA_OK = deltaOK

  ;FOLD Validate trajectory PTP velocity
    ; 0.0 identifies SEND manual/legacy and leaves the current programmed PTP
    ; velocity untouched. Positive values belong only to AxisTarget trajectory
    ; commands. Invalid mailbox values block motion.
    velocityOK = FALSE
    hasTrajectoryVelocity = FALSE

    IF ptpVelocityPct == 0.0 THEN
      velocityOK = TRUE
    ENDIF
    IF (ptpVelocityPct > 0.0) AND (ptpVelocityPct <= 100.0) THEN
      velocityOK = TRUE
      hasTrajectoryVelocity = TRUE
    ENDIF
    IF isCartesianMode AND hasTrajectoryVelocity THEN
      velocityOK = FALSE
    ENDIF
  ;ENDFOLD (Validate trajectory PTP velocity)

  ;FOLD Build target from mailbox
    IF isAxisMode THEN
      axisTarget = $AXIS_ACT
      axisTarget.A1 = targetA1
      axisTarget.A2 = targetA2
      axisTarget.A3 = targetA3
      axisTarget.A4 = targetA4
      axisTarget.A5 = targetA5
      axisTarget.A6 = targetA6
    ENDIF

    IF isCartesianMode THEN
      cartesianTarget = $POS_ACT
      cartesianTarget.X = targetX
      cartesianTarget.Y = targetY
      cartesianTarget.Z = targetZ
      cartesianTarget.A = targetA
      cartesianTarget.B = targetB
      cartesianTarget.C = targetC
    ENDIF
  ;ENDFOLD (Build target from mailbox)

  ;FOLD Determine readyToMove
    readyToMove = FALSE

    IF enableMove == TRUE THEN
      IF limitsOK == TRUE THEN
        IF deltaOK == TRUE THEN
          IF velocityOK == TRUE THEN
            IF snapshotOK == TRUE THEN
              readyToMove = TRUE
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF

    IF XD_EKI_ACTIVE == FALSE THEN
      readyToMove = FALSE
    ENDIF
    IF (isAxisMode == FALSE) AND (isCartesianMode == FALSE) THEN
      readyToMove = FALSE
    ENDIF

    XD_MOVE_READY = readyToMove
  ;ENDFOLD (Determine readyToMove)

  ;FOLD Act on a NEW sequence only
    ; A Seq is acted on exactly once.  handledSeq is advanced BEFORE the
    ; action, so nothing can replay it: not the heartbeat, not a restart.
    IF snapshotOK == TRUE THEN
      IF cmdSeq > 0 THEN
        IF cmdSeq <> handledSeq THEN
          IF XD_EKI_ACTIVE == TRUE THEN

            handledSeq = cmdSeq

            ;FOLD Gripper action
              ; -1 = do nothing (the bridge default), 0 = open, 1 = close.
              ; The SPS has already rejected any other value.
              IF gripperCmd == 0 THEN
                GRPg_SetStateAndCheck(1, 1, 0.2, 1)
              ENDIF
              IF gripperCmd == 1 THEN
                GRPg_SetStateAndCheck(1, 2, 0.2, 1)
              ENDIF
            ;ENDFOLD (Gripper action)

            ;FOLD Motion
              IF readyToMove == TRUE THEN
                IF isAxisMode THEN
                  IF hasTrajectoryVelocity THEN
                    BAS (#VEL_PTP,ptpVelocityPct)
                  ENDIF
                  PTP axisTarget
                ENDIF

                IF isCartesianMode THEN
                  PTP cartesianTarget
                ENDIF

                moveExecuted = TRUE
                XD_LAST_MOVE_SEQ = cmdSeq
                XD_MOVE_EXECUTED = TRUE
              ENDIF
            ;ENDFOLD (Motion)

          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ;ENDFOLD (Act on a NEW sequence only)

  WAIT SEC 0.1

ENDLOOP
;ENDFOLD (Move command loop)

; No EKI_Close here: the channel belongs to SPS.SUB and must survive this
; program being deselected.  That is the whole point of the redesign.

END
