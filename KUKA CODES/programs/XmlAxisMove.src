&ACCESS RV
&REL 1
&PARAM DISKPATH = KRC:\R1\Program
&PARAM SensorITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF XmlAxisMove( )

;FOLD Declaration
  INT i
  INT seq
  INT cmdSeq
  INT lastMoveSeq

  DECL EKI_STATUS RET
  DECL AXIS axisTarget

  CHAR cmdMode[64]

  BOOL enableMove
  BOOL limitsOK
  BOOL readyToMove
  BOOL moveExecuted
  BOOL deltaOK
  BOOL cmdReceived

  REAL targetA1
  REAL targetA2
  REAL targetA3
  REAL targetA4
  REAL targetA5
  REAL targetA6

  REAL errorA1
  REAL errorA2
  REAL errorA3
  REAL errorA4
  REAL errorA5
  REAL errorA6

  REAL MAX_DELTA
;ENDFOLD (Declaration)

;FOLD INI
  ;FOLD BASISTECH INI
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)

  ;FOLD USER INI
    ;Receives target joints from Ubuntu/ROS2 using EthernetKRL.
    ;Axis target is generated from GUI values A1...A6.
    ;Movement block must be enabled only by the responsible operator.
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD Initialize data
  FOR i=(1) TO (64)
    cmdMode[i]=0
  ENDFOR

  seq = 0
  cmdSeq = 0
  lastMoveSeq = -1

  enableMove = FALSE
  limitsOK = FALSE
  readyToMove = FALSE
  moveExecuted = FALSE
  deltaOK = FALSE
  cmdReceived = FALSE

  targetA1 = $AXIS_ACT.A1
  targetA2 = $AXIS_ACT.A2
  targetA3 = $AXIS_ACT.A3
  targetA4 = $AXIS_ACT.A4
  targetA5 = $AXIS_ACT.A5
  targetA6 = $AXIS_ACT.A6

  errorA1 = 0.0
  errorA2 = 0.0
  errorA3 = 0.0
  errorA4 = 0.0
  errorA5 = 0.0
  errorA6 = 0.0

  MAX_DELTA = 10.0

  axisTarget = $AXIS_ACT
;ENDFOLD (Initialize data)

;FOLD Configure PTP motion parameters
  $BWDSTART = FALSE
  $OV_PRO = 5
;ENDFOLD (Configure PTP motion parameters)

RET=EKI_Init("XmlAxisMove")
RET=EKI_Open("XmlAxisMove")

;FOLD Move command loop
LOOP

  seq = seq + 1

  ;FOLD Receive target command from Ubuntu
    cmdReceived = FALSE
    RET=EKI_CheckBuffer("XmlAxisMove", "Command/Seq")
    IF RET.Buff > 0 THEN
      RET=EKI_GetInt("XmlAxisMove","Command/Seq",cmdSeq)
      RET=EKI_GetString("XmlAxisMove","Command/Mode",cmdMode[])
      RET=EKI_GetBool("XmlAxisMove","Command/EnableMove",enableMove)

      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A1",targetA1)
      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A2",targetA2)
      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A3",targetA3)
      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A4",targetA4)
      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A5",targetA5)
      RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A6",targetA6)
      cmdReceived = TRUE
    ENDIF
  ;ENDFOLD (Receive target command from Ubuntu)

  ;FOLD Calculate error target - actual
    errorA1 = targetA1 - $AXIS_ACT.A1
    errorA2 = targetA2 - $AXIS_ACT.A2
    errorA3 = targetA3 - $AXIS_ACT.A3
    errorA4 = targetA4 - $AXIS_ACT.A4
    errorA5 = targetA5 - $AXIS_ACT.A5
    errorA6 = targetA6 - $AXIS_ACT.A6
  ;ENDFOLD (Calculate error target - actual)

  ;FOLD Validate limits
    limitsOK = TRUE

    IF targetA1 < -160.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA1 > 160.0 THEN
      limitsOK = FALSE
    ENDIF

    IF targetA2 < -180.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA2 > 35.0 THEN
      limitsOK = FALSE
    ENDIF

    IF targetA3 < -110.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA3 > 146.0 THEN
      limitsOK = FALSE
    ENDIF

    IF targetA4 < -175.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA4 > 175.0 THEN
      limitsOK = FALSE
    ENDIF

    IF targetA5 < -110.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA5 > 110.0 THEN
      limitsOK = FALSE
    ENDIF

    IF targetA6 < -340.0 THEN
      limitsOK = FALSE
    ENDIF
    IF targetA6 > 340.0 THEN
      limitsOK = FALSE
    ENDIF
  ;ENDFOLD (Validate limits)

  ;FOLD Validate delta (max jump per command)
    deltaOK = TRUE

    IF errorA1 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA1 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF

    IF errorA2 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA2 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF

    IF errorA3 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA3 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF

    IF errorA4 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA4 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF

    IF errorA5 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA5 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF

    IF errorA6 > MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
    IF errorA6 < -MAX_DELTA THEN
      deltaOK = FALSE
    ENDIF
  ;ENDFOLD (Validate delta)

  ;FOLD Build axis target from GUI
    axisTarget = $AXIS_ACT

    axisTarget.A1 = targetA1
    axisTarget.A2 = targetA2
    axisTarget.A3 = targetA3
    axisTarget.A4 = targetA4
    axisTarget.A5 = targetA5
    axisTarget.A6 = targetA6
  ;ENDFOLD (Build axis target from GUI)

  ;FOLD Determine readyToMove
    readyToMove = FALSE

    IF enableMove == TRUE THEN
      IF limitsOK == TRUE THEN
        IF deltaOK == TRUE THEN
          IF cmdReceived == TRUE THEN
            readyToMove = TRUE
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ;ENDFOLD (Determine readyToMove)

  ;FOLD Execute movement
    IF readyToMove == TRUE THEN
      IF cmdSeq > 0 THEN
        IF cmdSeq <> lastMoveSeq THEN
          ; New valid command, execute PTP movement
          PTP axisTarget
          lastMoveSeq = cmdSeq
          moveExecuted = TRUE

          ; Drain stale commands that accumulated during PTP
          RET=EKI_CheckBuffer("XmlAxisMove", "Command/Seq")
          WHILE RET.Buff > 0
            RET=EKI_GetInt("XmlAxisMove","Command/Seq",cmdSeq)
            RET=EKI_GetString("XmlAxisMove","Command/Mode",cmdMode[])
            RET=EKI_GetBool("XmlAxisMove","Command/EnableMove",enableMove)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A1",targetA1)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A2",targetA2)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A3",targetA3)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A4",targetA4)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A5",targetA5)
            RET=EKI_GetReal("XmlAxisMove","Command/AxisTarget/@A6",targetA6)
            RET=EKI_CheckBuffer("XmlAxisMove", "Command/Seq")
          ENDWHILE
          ; Update lastMoveSeq to the latest drained seq
          lastMoveSeq = cmdSeq

        ENDIF
      ENDIF
    ELSE
      moveExecuted = FALSE
    ENDIF
  ;ENDFOLD (Execute movement)

  ;FOLD Send actual robot position to Ubuntu
    RET=EKI_SetInt("XmlAxisMove","Robot/Seq",seq)
    RET=EKI_SetString("XmlAxisMove","Robot/Mode","AxisMove")

    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A1",$AXIS_ACT.A1)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A2",$AXIS_ACT.A2)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A3",$AXIS_ACT.A3)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A4",$AXIS_ACT.A4)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A5",$AXIS_ACT.A5)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/AxisActual/@A6",$AXIS_ACT.A6)

    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@X",$POS_ACT.X)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@Y",$POS_ACT.Y)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@Z",$POS_ACT.Z)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@A",$POS_ACT.A)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@B",$POS_ACT.B)
    RET=EKI_SetReal("XmlAxisMove","Robot/Data/PositionActual/@C",$POS_ACT.C)

    RET=EKI_SetInt("XmlAxisMove","Robot/Status",1)
    RET=EKI_SetBool("XmlAxisMove","Robot/MoveReady",readyToMove)
    RET=EKI_SetBool("XmlAxisMove","Robot/LimitsOK",limitsOK)
    RET=EKI_SetBool("XmlAxisMove","Robot/DeltaOK",deltaOK)
    RET=EKI_SetBool("XmlAxisMove","Robot/MoveExecuted",moveExecuted)

    RET=EKI_Send("XmlAxisMove","Robot")
  ;ENDFOLD (Send actual robot position to Ubuntu)

  WAIT SEC 0.1

ENDLOOP
;ENDFOLD (Move command loop)

RET=EKI_Close("XmlAxisMove")
RET=EKI_Clear("XmlAxisMove")

END
