&ACCESS  RVO
&COMMENT PLC on control
DEF  SPS ( )
  ;FOLD DECLARATIONS
  ;FOLD BASISTECH DECL
  ;Automatik extern
  DECL STATE_T STAT
  DECL MODUS_T MODE
  ;ENDFOLD (BASISTECH DECL)
  ;FOLD USER DECL
  ; Please insert user defined declarations

  ; XmlDualMove Submit declarations
  DECL EKI_STATUS XD_RET

  DECL INT xd_tempSeq
  DECL BOOL xd_tempEnableMove
  DECL CHAR xd_tempMode[64]
  DECL INT xd_tempI
  DECL INT xd_packetCounter
  DECL INT xd_sentMoveSeq
  DECL BOOL xd_packetOK
  DECL BOOL xd_channelOK
  DECL BOOL xd_sendOK
  DECL BOOL xd_sendMoveExecuted

  DECL REAL xd_tempA1
  DECL REAL xd_tempA2
  DECL REAL xd_tempA3
  DECL REAL xd_tempA4
  DECL REAL xd_tempA5
  DECL REAL xd_tempA6

  DECL REAL xd_tempX
  DECL REAL xd_tempY
  DECL REAL xd_tempZ
  DECL REAL xd_tempA
  DECL REAL xd_tempB
  DECL REAL xd_tempC

  ;ENDFOLD (USER DECL)
  ;ENDFOLD (DECLARATIONS)
  ;FOLD INI
  ;FOLD AUTOEXT INIT
  INTERRUPT DECL 91 WHEN $PRO_STATE1==#P_FREE DO RESET_OUT ()
  INTERRUPT ON 91
  INTERRUPT DECL 92 WHEN $PRO_MOVE==TRUE DO RESET_LINESEL()
  INTERRUPT ON 92
  $LOOP_MSG[]="                                                            "
  MODE=#SYNC
  $H_POS=$H_POS
  ;Automatik extern
  IF $MODE_OP==#EX THEN
    CWRITE($CMD,STAT,MODE,"RUN /R1/CELL()")
  ENDIF
  ;ENDFOLD (AUTOEXT INIT)
  ;FOLD BACKUPMANAGER PLC INIT
  BM_ENABLED = FALSE
  BM_OUTPUTVALUE = 0
  ;ENDFOLD (BACKUPMANAGER PLC INIT)
  ;FOLD USER INIT
  ; Please insert user defined initialization commands

  ; XmlDualMove Submit initialization
  XD_EKI_ACTIVE = FALSE
  XD_CMD_UPDATING = FALSE
  XD_CMD_RECEIVED = FALSE
  XD_ROBOT_BUSY = FALSE
  XD_DRAIN_REQUEST = FALSE
  XD_DRAIN_DONE = FALSE
  XD_LAST_DRAINED_SEQ = -1
  XD_LAST_MOVE_SEQ = -1
  XD_MOVE_EXECUTED = FALSE
  XD_SEND_COUNTER = 0
  XD_SEND_SEQ = 0
  FOR xd_tempI = 1 TO 64
    xd_tempMode[xd_tempI] = 0
  ENDFOR

  ;ENDFOLD (USER INIT)
  ;ENDFOLD (INI)

  LOOP
    WAIT FOR NOT($POWER_FAIL)
    ;FOLD BACKUPMANAGER PLC
    IF BM_ENABLED THEN
      BM_OUTPUTSIGNAL = BM_OUTPUTVALUE
    ENDIF
    ;ENDFOLD (BACKUPMANAGER PLC)
;START AUTOGENERATED -- DO NOT CHANGE -- GripperSpotTech sps SpsSub.add InsertGripperTechGlobals
    ;FOLD GRIPPERTECH LOOP
      GRPg_ChkSetStatePLC()
   ;ENDFOLD (GRIPPERTECH LOOP)
;END AUTOGENERATED -- DO NOT CHANGE -- (GripperSpotTech sps SpsSub.add InsertGripperTechGlobals)
    ;FOLD USER PLC
    ;Make your modifications here

    ; XmlDualMove Submit communication
    ; EKI_STATUS: Msg_No, Connected, Read, Buff and Counter.
    IF (XD_USE_SUBMIT == TRUE) AND (XD_EKI_ACTIVE == TRUE) THEN
      xd_channelOK = TRUE

      ; Consume while busy; publish only when the slot is free.
      IF ((XD_ROBOT_BUSY == TRUE) AND (XD_DRAIN_DONE == FALSE)) OR (XD_CMD_RECEIVED == FALSE) THEN
        XD_RET = EKI_CheckBuffer("XmlDualMove", "Command/Seq")
        IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
          xd_channelOK = FALSE
        ELSE
          IF XD_RET.Buff > 0 THEN
            xd_packetOK = TRUE
            xd_packetCounter = -1

            ; Seq establishes the packet Counter.
            XD_RET = EKI_GetInt("XmlDualMove", "Command/Seq", xd_tempSeq)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_channelOK = FALSE
              xd_packetOK = FALSE
            ELSE
              IF XD_RET.Read <> 1 THEN
                xd_packetOK = FALSE
              ELSE
                xd_packetCounter = XD_RET.Counter
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetString("XmlDualMove", "Command/Mode", xd_tempMode[])
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetBool("XmlDualMove", "Command/EnableMove", xd_tempEnableMove)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A1", xd_tempA1)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A2", xd_tempA2)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A3", xd_tempA3)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A4", xd_tempA4)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A5", xd_tempA5)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/AxisTarget/@A6", xd_tempA6)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@X", xd_tempX)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@Y", xd_tempY)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@Z", xd_tempZ)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@A", xd_tempA)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@B", xd_tempB)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              XD_RET = EKI_GetReal("XmlDualMove", "Command/CartesianTarget/@C", xd_tempC)
              IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                xd_channelOK = FALSE
                xd_packetOK = FALSE
              ELSE
                IF (XD_RET.Read <> 1) OR (XD_RET.Counter <> xd_packetCounter) THEN
                  xd_packetOK = FALSE
                ENDIF
              ENDIF
            ENDIF

            IF xd_channelOK THEN
              IF xd_packetOK THEN
                IF XD_ROBOT_BUSY AND (XD_DRAIN_DONE == FALSE) THEN
                  XD_LAST_DRAINED_SEQ = xd_tempSeq
                  XD_CMD_RECEIVED = FALSE
                ELSE
                  XD_CMD_UPDATING = TRUE
                  XD_TARGET_A1 = xd_tempA1
                  XD_TARGET_A2 = xd_tempA2
                  XD_TARGET_A3 = xd_tempA3
                  XD_TARGET_A4 = xd_tempA4
                  XD_TARGET_A5 = xd_tempA5
                  XD_TARGET_A6 = xd_tempA6
                  XD_TARGET_X = xd_tempX
                  XD_TARGET_Y = xd_tempY
                  XD_TARGET_Z = xd_tempZ
                  XD_TARGET_A = xd_tempA
                  XD_TARGET_B = xd_tempB
                  XD_TARGET_C = xd_tempC
                  XD_ENABLE_MOVE = xd_tempEnableMove
                  XD_AXIS_MODE = (xd_tempMode[1] == "A") OR (xd_tempMode[1] == "a")
                  XD_CART_MODE = (xd_tempMode[1] == "C") OR (xd_tempMode[1] == "c")
                  XD_CMD_RECEIVED = TRUE
                  ; Publish sequence last.
                  XD_CMD_SEQ = xd_tempSeq
                  XD_CMD_UPDATING = FALSE
                ENDIF
              ELSE
                ; Exceptional recovery for an inconsistent packet.
                XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/Seq")
                IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                  xd_channelOK = FALSE
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/Mode")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/EnableMove")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A1")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A2")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A3")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A4")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A5")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/AxisTarget/@A6")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@X")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@Y")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@Z")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@A")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@B")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
                IF xd_channelOK THEN
                  XD_RET = EKI_ClearBuffer("XmlDualMove", "Command/CartesianTarget/@C")
                  IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
                    xd_channelOK = FALSE
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF

      ; Post-PTP drain acknowledgement.
      IF xd_channelOK AND XD_ROBOT_BUSY AND XD_DRAIN_REQUEST THEN
        XD_RET = EKI_CheckBuffer("XmlDualMove", "Command/Seq")
        IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
          xd_channelOK = FALSE
        ELSE
          IF XD_RET.Buff < 1 THEN
            XD_DRAIN_DONE = TRUE
          ENDIF
        ENDIF
      ENDIF

      ; Stop telemetry after the first failed Set/Send.
      IF xd_channelOK THEN
        XD_SEND_COUNTER = XD_SEND_COUNTER + 1
        IF XD_SEND_COUNTER >= XD_SEND_DIVISOR THEN
          XD_SEND_COUNTER = 0
          XD_SEND_SEQ = XD_SEND_SEQ + 1
          xd_sendOK = TRUE
          xd_sentMoveSeq = XD_LAST_MOVE_SEQ
          xd_sendMoveExecuted = XD_MOVE_EXECUTED

          XD_RET = EKI_SetInt("XmlDualMove", "Robot/Seq", XD_SEND_SEQ)
          IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
            xd_sendOK = FALSE
            xd_channelOK = FALSE
          ENDIF

          IF xd_sendOK THEN
            IF XD_CART_MODE THEN
              XD_RET = EKI_SetString("XmlDualMove", "Robot/Mode", "CartesianTarget")
            ELSE
              XD_RET = EKI_SetString("XmlDualMove", "Robot/Mode", "AxisTarget")
            ENDIF
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF

          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A1", $AXIS_ACT.A1)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A2", $AXIS_ACT.A2)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A3", $AXIS_ACT.A3)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A4", $AXIS_ACT.A4)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A5", $AXIS_ACT.A5)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/AxisActual/@A6", $AXIS_ACT.A6)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF

          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@X", $POS_ACT.X)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@Y", $POS_ACT.Y)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@Z", $POS_ACT.Z)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@A", $POS_ACT.A)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@B", $POS_ACT.B)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetReal("XmlDualMove", "Robot/Data/PositionActual/@C", $POS_ACT.C)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF

          IF xd_sendOK THEN
            XD_RET = EKI_SetInt("XmlDualMove", "Robot/Status", 1)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetBool("XmlDualMove", "Robot/MoveReady", XD_MOVE_READY)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetBool("XmlDualMove", "Robot/LimitsOK", XD_LIMITS_OK)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetBool("XmlDualMove", "Robot/DeltaOK", XD_DELTA_OK)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_SetBool("XmlDualMove", "Robot/MoveExecuted", xd_sendMoveExecuted)
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF
          IF xd_sendOK THEN
            XD_RET = EKI_Send("XmlDualMove", "Robot")
            IF (XD_RET.Msg_No <> 0) OR (XD_RET.Connected == FALSE) THEN
              xd_sendOK = FALSE
              xd_channelOK = FALSE
            ENDIF
          ENDIF

          ; Report MoveExecuted once for the captured move sequence.
          IF xd_sendOK AND xd_sendMoveExecuted THEN
            IF XD_LAST_MOVE_SEQ == xd_sentMoveSeq THEN
              XD_MOVE_EXECUTED = FALSE
            ENDIF
          ENDIF
        ENDIF
      ENDIF

      ; Fail safe on any EKI error or disconnected status.  No automatic reopen.
      IF xd_channelOK == FALSE THEN
        XD_EKI_ACTIVE = FALSE
        XD_ENABLE_MOVE = FALSE
        XD_MOVE_READY = FALSE
        XD_CMD_RECEIVED = FALSE
        XD_CMD_UPDATING = FALSE
      ENDIF
    ENDIF

    ;ENDFOLD (USER PLC)
  ENDLOOP
  ;FOLD ;%{H}
  ;FOLD
END
  ;ENDFOLD


DEF  RESET_OUT ( )
  INT N
  MsgLoop(" ")
  IF REFLECT_PROG_NR == 1 THEN
    FOR N = 0 TO PGNO_LENGTH - 1
      $OUT[PGNO_FBIT_REFL + N] = FALSE
    ENDFOR
  ENDIF
  IF (PGNO_REQ>0) THEN
    $OUT[PGNO_REQ]=FALSE
  ELSE
    IF (PGNO_REQ<0) THEN
      $OUT[-PGNO_REQ]=TRUE
    ENDIF
  ENDIF
END

DEF RESET_LINESEL()
  $LINE_SEL_OK=FALSE
END
