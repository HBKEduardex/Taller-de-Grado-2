&ACCESS RVP
&REL 90
&PARAM SensorITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program
DEF XmlServer( )


;FOLD Declaration
  DECL EKI_STATUS RET
  INT OFFSET
  REAL ind

  BOOL valueBool
  INT i
  REAL valueReal
  CHAR Bytes[4]
  FOR i=(1) TO (4)
     Bytes[i]=0
  ENDFOR
  OFFSET=0
  ind=0.0
;ENDFOLD (Declaration)

;FOLD INI
  ;FOLD BASISTECH INI
  BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
RET=EKI_Init("XmlServer")
RET=EKI_Open("XmlServer")

; wait until server is conntected
wait for $FLAG[1]
REPEAT
    RET=EKI_GetString("XmlServer","number",Bytes[])
    OFFSET=0
    CAST_FROM(Bytes[],OFFSET,valueReal)
UNTIL (RET.Buff < 1)
IF valueReal >0 THEN
    valueBool=TRUE

SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
REPEAT
   PTP_REL {Z -10}
   ind=ind+1.0
UNTIL (valueReal< ind)
ENDIF
wait for valueBool
; wait until server is deconnected
wait for $FLAG[1]==FALSE

RET=EKI_Clear("XmlServer")
END
