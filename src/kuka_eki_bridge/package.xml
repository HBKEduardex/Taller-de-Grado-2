<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_eki_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS2 bridge for KUKA EthernetKRL (EKI) communication via TCP/IP and XML.
    Replaces EthernetKRL_Server.exe on Ubuntu for receiving XML data from
    KUKA robots running XmlTransmit.src.
  </description>
  <maintainer email="eduardex@todo.com">eduardex</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
